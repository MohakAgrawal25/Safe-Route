# =================================================================
# SafeRoute AI - Environment Configuration Example
# =================================================================

# Geographic Scope: Chicago, Illinois (7 km Study Area)
STUDY_AREA_NAME="Chicago Central & Middle Metro Study Area"
STUDY_AREA_CENTER_LAT=41.8700
STUDY_AREA_CENTER_LON=-87.6700
STUDY_AREA_RADIUS_METERS=7000.0

# Pedestrian & Routing Parameters
WALKING_SPEED_MPS=1.39
DEFAULT_CRIME_BUFFER_METERS=75.0
DEFAULT_LAMBDA=2.5
MAX_DETOUR_RATIO=0.30
RECENCY_DECAY_HALF_LIFE_DAYS=180.0

# PostgreSQL option: postgresql://username:password@localhost:5432/safe_route

# Official Chicago Data Portal (Socrata API)
# Optional app token for high-volume Socrata queries: https://data.cityofchicago.org/profile/edit/developer_settings
CHICAGO_API_APP_TOKEN=
